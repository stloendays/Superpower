{
  "name": "@superpower/mcp-core",
  "version": "1.4.0",
  "description": "Browser-agnostic Superpower MCP routing, policy, budgeting and telemetry core",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "types": "index.mts",
  "main": "dist/index.mjs",
  "scripts": {
    "ready": "tsc -b",
    "build": "tsc -b",
    "type-check": "tsc --noEmit",
    "test:router": "node scripts/tool-router-smoke.mjs",
    "test:planner": "node scripts/action-planner-smoke.mjs",
    "test:policy": "node scripts/execution-policy-smoke.mjs",
    "prettier": "prettier . --write --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "@types/node": "^22.5.5"
  }
}
